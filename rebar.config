{deps, [
    {ranch, "2.2.1"},
    {uuid, "2.0.7", {pkg, uuid_erl}},
    {iso8601, "1.4.0"},
    {recon, "2.5.6"}
]}.

{erl_opts, [debug_info]}.

{alias, [{check, [xref, dialyzer, eunit, ct]}]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [recon]},
    {exclude_apps, [xmerl]},
    {plt_extra_mods, [xmerl_scan]},
    {get_warnings, false}
]}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
    % Too much exported function are not used for this to be useful.
    %exports_not_used
]}.

{profiles, [
    {test, [
        {deps, [meck, unite]},
        {pre_hooks, [{ct, "./scripts/generate_certificates.sh"}]},
        {eunit_opts, [no_tty, {report, {unite_compact, []}}]},
        {dist_node, [
            {setcookie, 'ct_test'},
            {sname, 'ct_master'}
        ]}
    ]},
    {client, [
        {shell, [
            {config, "./config/client.config"},
            {apps, [opcua, ranch, xmerl, recon, runtime_tools]}
        ]}
    ]},
    {server, [
        {shell, [
            {config, "./config/server.config"},
            {apps, [opcua, ranch, xmerl, recon, runtime_tools]}
        ]}
    ]}
]}.

{shell, [
    {config, "./config/client.config"},
    {apps, [opcua, ranch, xmerl, recon, runtime_tools]}
]}.

{relx, [{release, {opcua, "0.1.0"},
	[opcua, ranch, xmerl, recon]},
        {dev_mode, true},
        {include_erts, false},
        {extended_start_script, true}]}.
